  </div>
</why-box-{{ ai_gen_id }}>

<script>
  (function() {
    class WhyBox{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('why-box-{{ ai_gen_id }}', WhyBox{{ ai_gen_id }});
  })();
</script>

