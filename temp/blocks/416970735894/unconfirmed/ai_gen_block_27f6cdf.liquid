{% doc %}
  @prompt
    Create a fully customizable Shopify Online Store 2.0 section called **"Promotional Countdown Banner"** that recreates the attached design while allowing every visual element to be modified through the Shopify Theme Editor without editing code. The section should consist of a centered rounded rectangular container with adjustable width, height, padding, margin, border thickness, border radius, border color, background color, shadow, and spacing. It should contain three vertically stacked rows: the first row has editable promotional text (e.g., "BUY 3 GET 1") alongside an editable badge (e.g., "FREE"), where the badge text, background color, text color, corner radius, padding, and spacing are all configurable; the second row contains an optional icon and editable promotional message (e.g., "🔥 LAST FEW HOURS LEFT"), with controls for icon selection, icon size, icon color, text, font size, font weight, text color, alignment, and spacing; the third row contains an optional icon and a live countdown timer that updates every second and counts down to a user-selected target date and time. The countdown must display only **HH:MM:SS**, converting any remaining days into hours (for example, 2 days 5 hours should display as **53:00:00**) and stopping at **00:00:00** when expired. Include settings for the target date, target time, timezone, and expiration behavior. Every text element should have independent controls for font size, font weight, text color, letter spacing, line height, and alignment. Every color used in the section should be independently editable, including the background, border, promotional text, badge background, badge text, icons, countdown timer, and secondary text. The spacing and positioning of every row and every individual element should be adjustable, including gaps between rows, gaps between icons and text, internal padding, and overall content alignment. The section must be fully responsive, use semantic HTML, Shopify Liquid, CSS variables where appropriate, and minimal vanilla JavaScript with no external libraries. Generate the complete `.liquid` section including the schema so every visual property and piece of text can be customized directly from Shopify's Theme Editor., Allow us to also choose what part of the timer to choose (Days, Hours, Minutes, Seconds)., Showing/Hiding the timer parts should not recalculate. Assume it is in days, even if the days are hidden.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-promo-countdown-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_margin_top }}px {{ block.settings.section_margin_horizontal }}px {{ block.settings.section_margin_bottom }}px {{ block.settings.section_margin_horizontal }}px;
  }

  .ai-promo-countdown-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_max_width }}px;
    margin: 0 auto;
    padding: {{ block.settings.container_padding_vertical }}px {{ block.settings.container_padding_horizontal }}px;
    background-color: {{ block.settings.container_bg_color }};
    border: {{ block.settings.container_border_width }}px solid {{ block.settings.container_border_color }};
    border-radius: {{ block.settings.container_border_radius }}px;
    {% if block.settings.container_shadow %}
      box-shadow: 0 {{ block.settings.shadow_offset_y }}px {{ block.settings.shadow_blur }}px {{ block.settings.shadow_spread }}px {{ block.settings.shadow_color }};
    {% endif %}
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.rows_gap }}px;
    align-items: {{ block.settings.content_alignment }};
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-promo-countdown-row-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: {{ block.settings.content_alignment }};
    gap: {{ block.settings.row_internal_gap }}px;
    flex-wrap: wrap;
    width: 100%;
  }

  .ai-promo-countdown-promo-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.promo_text_font_size }}px;
    font-weight: {{ block.settings.promo_text_font_weight }};
    color: {{ block.settings.promo_text_color }};
    letter-spacing: {{ block.settings.promo_text_letter_spacing }}px;
    line-height: {{ block.settings.promo_text_line_height }};
    margin: 0;
  }

  .ai-promo-countdown-badge-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.badge_padding_vertical }}px {{ block.settings.badge_padding_horizontal }}px;
    background-color: {{ block.settings.badge_bg_color }};
    color: {{ block.settings.badge_text_color }};
    border-radius: {{ block.settings.badge_border_radius }}px;
    font-size: {{ block.settings.badge_font_size }}px;
    font-weight: {{ block.settings.badge_font_weight }};
    letter-spacing: {{ block.settings.badge_letter_spacing }}px;
    line-height: {{ block.settings.badge_line_height }};
  }

  .ai-promo-countdown-message-{{ ai_gen_id }} {
    font-size: {{ block.settings.message_font_size }}px;
    font-weight: {{ block.settings.message_font_weight }};
    color: {{ block.settings.message_text_color }};
    letter-spacing: {{ block.settings.message_letter_spacing }}px;
    line-height: {{ block.settings.message_line_height }};
    margin: 0;
    display: flex;
    align-items: center;
    gap: {{ block.settings.message_icon_gap }}px;
  }

  .ai-promo-countdown-icon-{{ ai_gen_id }} {
    font-size: {{ block.settings.icon_size }}px;
    color: {{ block.settings.icon_color }};
    line-height: 1;
  }

  .ai-promo-countdown-timer-wrapper-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.timer_icon_gap }}px;
  }

  .ai-promo-countdown-timer-{{ ai_gen_id }} {
    font-size: {{ block.settings.timer_font_size }}px;
    font-weight: {{ block.settings.timer_font_weight }};
    color: {{ block.settings.timer_text_color }};
    letter-spacing: {{ block.settings.timer_letter_spacing }}px;
    line-height: {{ block.settings.timer_line_height }};
    font-variant-numeric: tabular-nums;
    margin: 0;
    display: flex;
    gap: {{ block.settings.timer_units_gap }}px;
  }

  .ai-promo-countdown-timer-unit-{{ ai_gen_id }} {
    display: inline-block;
  }

  .ai-promo-countdown-timer-icon-{{ ai_gen_id }} {
    font-size: {{ block.settings.timer_icon_size }}px;
    color: {{ block.settings.timer_icon_color }};
    line-height: 1;
  }

  .ai-promo-countdown-expired-{{ ai_gen_id }} {
    font-size: {{ block.settings.expired_font_size }}px;
    font-weight: {{ block.settings.expired_font_weight }};
    color: {{ block.settings.expired_text_color }};
    letter-spacing: {{ block.settings.expired_letter_spacing }}px;
    line-height: {{ block.settings.expired_line_height }};
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-promo-countdown-{{ ai_gen_id }} {
      padding: {{ block.settings.section_margin_top_mobile }}px {{ block.settings.section_margin_horizontal_mobile }}px {{ block.settings.section_margin_bottom_mobile }}px {{ block.settings.section_margin_horizontal_mobile }}px;
    }

    .ai-promo-countdown-container-{{ ai_gen_id }} {
      padding: {{ block.settings.container_padding_vertical_mobile }}px {{ block.settings.container_padding_horizontal_mobile }}px;
    }

    .ai-promo-countdown-promo-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.promo_text_font_size_mobile }}px;
    }

    .ai-promo-countdown-badge-{{ ai_gen_id }} {
      font-size: {{ block.settings.badge_font_size_mobile }}px;
    }

    .ai-promo-countdown-message-{{ ai_gen_id }} {
      font-size: {{ block.settings.message_font_size_mobile }}px;
    }

    .ai-promo-countdown-timer-{{ ai_gen_id }} {
      font-size: {{ block.settings.timer_font_size_mobile }}px;
    }

    .ai-promo-countdown-expired-{{ ai_gen_id }} {
      font-size: {{ block.settings.expired_font_size_mobile }}px;
    }
  }
{% endstyle %}

<promo-countdown-{{ ai_gen_id }}
  class="ai-promo-countdown-{{ ai_gen_id }}"
  data-target-date="{{ block.settings.target_date }}"
  data-target-time="{{ block.settings.target_time }}"
  data-hide-on-expire="{{ block.settings.hide_on_expire }}"
  data-show-days="{{ block.settings.show_days }}"
  data-show-hours="{{ block.settings.show_hours }}"
  data-show-minutes="{{ block.settings.show_minutes }}"
  data-show-seconds="{{ block.settings.show_seconds }}"
  data-timer-separator="{{ block.settings.timer_separator }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-promo-countdown-container-{{ ai_gen_id }}">
    {% if block.settings.show_promo_row %}
      <div class="ai-promo-countdown-row-{{ ai_gen_id }}">
        {% if block.settings.promo_text != blank %}
          <div class="ai-promo-countdown-promo-text-{{ ai_gen_id }}">
            {{ block.settings.promo_text }}
          </div>
        {% endif %}
        {% if block.settings.badge_text != blank %}
          <span class="ai-promo-countdown-badge-{{ ai_gen_id }}">
            {{ block.settings.badge_text }}
          </span>
        {% endif %}
      </div>
    {% endif %}

    {% if block.settings.show_message_row %}
      <div class="ai-promo-countdown-row-{{ ai_gen_id }}">
        <div class="ai-promo-countdown-message-{{ ai_gen_id }}">
          {% if block.settings.message_icon != blank %}
            <span class="ai-promo-countdown-icon-{{ ai_gen_id }}">{{ block.settings.message_icon }}</span>
          {% endif %}
          {% if block.settings.message_text != blank %}
            <span>{{ block.settings.message_text }}</span>
          {% endif %}
        </div>
      </div>
    {% endif %}

    {% if block.settings.show_timer_row %}
      <div class="ai-promo-countdown-row-{{ ai_gen_id }}">
        <div class="ai-promo-countdown-timer-wrapper-{{ ai_gen_id }}">
          {% if block.settings.timer_icon != blank %}
            <span class="ai-promo-countdown-timer-icon-{{ ai_gen_id }}">{{ block.settings.timer_icon }}</span>
          {% endif %}
          <div class="ai-promo-countdown-timer-{{ ai_gen_id }}" data-timer></div>
        </div>
        <div class="ai-promo-countdown-expired-{{ ai_gen_id }}" data-expired style="display: none;">
          {{ block.settings.expired_message }}
        </div>
      </div>
    {% endif %}
  </div>
</promo-countdown-{{ ai_gen_id }}>

<script>
  (function() {
    class PromoCountdown{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.timerElement = this.querySelector('[data-timer]');
        this.expiredElement = this.querySelector('[data-expired]');
        this.targetDate = this.dataset.targetDate;
        this.targetTime = this.dataset.targetTime;
        this.hideOnExpire = this.dataset.hideOnExpire === 'true';
        this.showDays = this.dataset.showDays === 'true';
        this.showHours = this.dataset.showHours === 'true';
        this.showMinutes = this.dataset.showMinutes === 'true';
        this.showSeconds = this.dataset.showSeconds === 'true';
        this.separator = this.dataset.timerSeparator || ':';
        this.intervalId = null;
      }

      connectedCallback() {
        if (this.targetDate && this.targetTime) {
          this.startCountdown();
        }
      }

      disconnectedCallback() {
        if (this.intervalId) {
          clearInterval(this.intervalId);
        }
      }

      startCountdown() {
        const targetDateTime = new Date(this.targetDate + 'T' + this.targetTime);
        
        const updateTimer = () => {
          const now = new Date();
          const difference = targetDateTime - now;

          if (difference <= 0) {
            this.handleExpiration();
            return;
          }

          const totalSeconds = Math.floor(difference / 1000);
          const days = Math.floor(totalSeconds / 86400);
          const hours = Math.floor((totalSeconds % 86400) / 3600);
          const minutes = Math.floor((totalSeconds % 3600) / 60);
          const seconds = totalSeconds % 60;

          const parts = [];

          if (this.showDays) {
            parts.push(String(days).padStart(2, '0'));
          }
          
          if (this.showHours) {
            parts.push(String(hours).padStart(2, '0'));
          }
          
          if (this.showMinutes) {
            parts.push(String(minutes).padStart(2, '0'));
          }
          
          if (this.showSeconds) {
            parts.push(String(seconds).padStart(2, '0'));
          }

          const formattedTime = parts.join(this.separator);

          if (this.timerElement) {
            this.timerElement.textContent = formattedTime;
          }
        };

        updateTimer();
        this.intervalId = setInterval(updateTimer, 1000);
      }

      handleExpiration() {
        if (this.intervalId) {
          clearInterval(this.intervalId);
        }

        const parts = [];
        if (this.showDays) parts.push('00');
        if (this.showHours) parts.push('00');
        if (this.showMinutes) parts.push('00');
        if (this.showSeconds) parts.push('00');

        if (this.timerElement) {
          this.timerElement.textContent = parts.join(this.separator);
        }

        if (this.hideOnExpire) {
          this.style.display = 'none';
        } else {
          if (this.timerElement) {
            this.timerElement.style.display = 'none';
          }
          if (this.expiredElement) {
            this.expiredElement.style.display = 'block';
          }
        }
      }
    }

    customElements.define('promo-countdown-{{ ai_gen_id }}', PromoCountdown{{ ai_gen_id }});
  })();
</script>

