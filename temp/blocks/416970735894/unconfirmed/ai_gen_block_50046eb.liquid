{% doc %}
  @prompt
    A horizontally long block that has:
    - A timer block to count down to a specific date and time. Allow me to select what to show from the countdown (minutes, hours, etc)
    - A Heading Text
    - 3 blocks of subtext
    - An exclamation mark that shakes (acts as a main icon in the left side of the block)
    - Glowing outline setting
    - Allow us to change all colors of everything in this block.
    - Allow us to give margins on all four sides., I want something that is muchhhh smaller in the height. The exclamation mark should be to the left, The heading in the top, the timer in the bottom (much smaller), the three texts would be to the right side., This is good but i want a better looking UI. Also the time is still on top. It should be centered in the bottom. The main text should be centered uptop.
    The exclamation mark should be in the same line as the three texts (side by side)
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-countdown-banner-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    box-sizing: border-box;
  }

  .ai-countdown-banner-container-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 16px 24px;
    background: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    margin-top: {{ block.settings.margin_top }}px;
    margin-bottom: {{ block.settings.margin_bottom }}px;
    margin-left: {{ block.settings.margin_left }}px;
    margin-right: {{ block.settings.margin_right }}px;
    {% if block.settings.enable_glow %}
      box-shadow: 0 0 {{ block.settings.glow_intensity }}px {{ block.settings.glow_color }};
    {% endif %}
    position: relative;
    overflow: hidden;
  }

  .ai-countdown-banner-container-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, 
      {{ block.settings.accent_color_1 }} 0%, 
      {{ block.settings.accent_color_2 }} 50%, 
      {{ block.settings.accent_color_1 }} 100%);
  }

  .ai-countdown-banner-heading-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    font-weight: 700;
    text-align: center;
    line-height: 1.2;
    letter-spacing: 0.5px;
  }

  .ai-countdown-banner-middle-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 16px;
    justify-content: space-between;
  }

  .ai-countdown-banner-icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    animation: ai-countdown-shake-{{ ai_gen_id }} 0.6s ease-in-out infinite;
    filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.2));
  }

  .ai-countdown-banner-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    fill: {{ block.settings.icon_color }};
  }

  @keyframes ai-countdown-shake-{{ ai_gen_id }} {
    0%, 100% {
      transform: rotate(0deg);
    }
    25% {
      transform: rotate(-12deg);
    }
    75% {
      transform: rotate(12deg);
    }
  }

  .ai-countdown-banner-subtext-{{ ai_gen_id }} {
    display: flex;
    gap: 20px;
    align-items: center;
    flex-grow: 1;
    justify-content: flex-end;
  }

  .ai-countdown-banner-subtext-item-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtext_size }}px;
    color: {{ block.settings.subtext_color }};
    margin: 0;
    line-height: 1.3;
    font-weight: 500;
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .ai-countdown-banner-subtext-item-{{ ai_gen_id }}::before {
    content: '•';
    color: {{ block.settings.accent_color_1 }};
    font-size: 1.2em;
  }

  .ai-countdown-banner-timer-{{ ai_gen_id }} {
    display: flex;
    gap: 12px;
    align-items: center;
    justify-content: center;
  }

  .ai-countdown-banner-timer-unit-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    background: {{ block.settings.timer_background }};
    padding: 6px 10px;
    border-radius: 6px;
    min-width: 45px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .ai-countdown-banner-timer-value-{{ ai_gen_id }} {
    font-size: {{ block.settings.timer_size }}px;
    font-weight: 800;
    color: {{ block.settings.timer_color }};
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .ai-countdown-banner-timer-label-{{ ai_gen_id }} {
    font-size: {{ block.settings.timer_label_size }}px;
    color: {{ block.settings.timer_label_color }};
    text-transform: uppercase;
    line-height: 1;
    font-weight: 600;
    letter-spacing: 0.5px;
  }

  .ai-countdown-banner-timer-separator-{{ ai_gen_id }} {
    font-size: {{ block.settings.timer_size }}px;
    color: {{ block.settings.timer_color }};
    font-weight: 700;
    line-height: 1;
    opacity: 0.5;
  }

  @media screen and (max-width: 749px) {
    .ai-countdown-banner-container-{{ ai_gen_id }} {
      padding: 12px 16px;
      gap: 10px;
    }

    .ai-countdown-banner-middle-{{ ai_gen_id }} {
      flex-direction: column;
      gap: 12px;
    }

    .ai-countdown-banner-subtext-{{ ai_gen_id }} {
      flex-direction: column;
      gap: 8px;
      width: 100%;
      align-items: flex-start;
    }

    .ai-countdown-banner-icon-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size | times: 0.7 }}px;
      height: {{ block.settings.icon_size | times: 0.7 }}px;
    }

    .ai-countdown-banner-timer-unit-{{ ai_gen_id }} {
      min-width: 38px;
      padding: 5px 8px;
    }

    .ai-countdown-banner-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.85 }}px;
    }
  }
{% endstyle %}

<countdown-banner-{{ ai_gen_id }}
  class="ai-countdown-banner-{{ ai_gen_id }}"
  data-end-date="{{ block.settings.countdown_date }}"
  data-end-time="{{ block.settings.countdown_time }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-countdown-banner-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-countdown-banner-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    <div class="ai-countdown-banner-middle-{{ ai_gen_id }}">
      <div class="ai-countdown-banner-icon-{{ ai_gen_id }}">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2" fill="none"/>
          <path d="M12 6V13" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
          <circle cx="12" cy="17" r="1.5" fill="currentColor"/>
        </svg>
      </div>

      <div class="ai-countdown-banner-subtext-{{ ai_gen_id }}">
        {% if block.settings.subtext_1 != blank %}
          <p class="ai-countdown-banner-subtext-item-{{ ai_gen_id }}">{{ block.settings.subtext_1 }}</p>
        {% endif %}
        {% if block.settings.subtext_2 != blank %}
          <p class="ai-countdown-banner-subtext-item-{{ ai_gen_id }}">{{ block.settings.subtext_2 }}</p>
        {% endif %}
        {% if block.settings.subtext_3 != blank %}
          <p class="ai-countdown-banner-subtext-item-{{ ai_gen_id }}">{{ block.settings.subtext_3 }}</p>
        {% endif %}
      </div>
    </div>

    <div class="ai-countdown-banner-timer-{{ ai_gen_id }}">
      {% if block.settings.show_days %}
        <div class="ai-countdown-banner-timer-unit-{{ ai_gen_id }}">
          <div class="ai-countdown-banner-timer-value-{{ ai_gen_id }}" data-days>00</div>
          <div class="ai-countdown-banner-timer-label-{{ ai_gen_id }}">Days</div>
        </div>
        {% if block.settings.show_hours or block.settings.show_minutes or block.settings.show_seconds %}
          <div class="ai-countdown-banner-timer-separator-{{ ai_gen_id }}">:</div>
        {% endif %}
      {% endif %}

      {% if block.settings.show_hours %}
        <div class="ai-countdown-banner-timer-unit-{{ ai_gen_id }}">
          <div class="ai-countdown-banner-timer-value-{{ ai_gen_id }}" data-hours>00</div>
          <div class="ai-countdown-banner-timer-label-{{ ai_gen_id }}">Hrs</div>
        </div>
        {% if block.settings.show_minutes or block.settings.show_seconds %}
          <div class="ai-countdown-banner-timer-separator-{{ ai_gen_id }}">:</div>
        {% endif %}
      {% endif %}

      {% if block.settings.show_minutes %}
        <div class="ai-countdown-banner-timer-unit-{{ ai_gen_id }}">
          <div class="ai-countdown-banner-timer-value-{{ ai_gen_id }}" data-minutes>00</div>
          <div class="ai-countdown-banner-timer-label-{{ ai_gen_id }}">Min</div>
        </div>
        {% if block.settings.show_seconds %}
          <div class="ai-countdown-banner-timer-separator-{{ ai_gen_id }}">:</div>
        {% endif %}
      {% endif %}

      {% if block.settings.show_seconds %}
        <div class="ai-countdown-banner-timer-unit-{{ ai_gen_id }}">
          <div class="ai-countdown-banner-timer-value-{{ ai_gen_id }}" data-seconds>00</div>
          <div class="ai-countdown-banner-timer-label-{{ ai_gen_id }}">Sec</div>
        </div>
      {% endif %}
    </div>
  </div>
</countdown-banner-{{ ai_gen_id }}>

<script>
  (function() {
    class CountdownBanner{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.endDate = this.dataset.endDate;
        this.endTime = this.dataset.endTime;
        this.interval = null;
      }

      connectedCallback() {
        this.startCountdown();
      }

      disconnectedCallback() {
        if (this.interval) {
          clearInterval(this.interval);
        }
      }

      startCountdown() {
        if (!this.endDate || !this.endTime) {
          return;
        }

        const endDateTime = new Date(this.endDate + 'T' + this.endTime).getTime();

        this.interval = setInterval(() => {
          const now = new Date().getTime();
          const distance = endDateTime - now;

          if (distance < 0) {
            clearInterval(this.interval);
            this.updateDisplay(0, 0, 0, 0);
            return;
          }

          const days = Math.floor(distance / (1000 * 60 * 60 * 24));
          const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
          const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
          const seconds = Math.floor((distance % (1000 * 60)) / 1000);

          this.updateDisplay(days, hours, minutes, seconds);
        }, 1000);
      }

      updateDisplay(days, hours, minutes, seconds) {
        const daysEl = this.querySelector('[data-days]');
        const hoursEl = this.querySelector('[data-hours]');
        const minutesEl = this.querySelector('[data-minutes]');
        const secondsEl = this.querySelector('[data-seconds]');

        if (daysEl) daysEl.textContent = String(days).padStart(2, '0');
        if (hoursEl) hoursEl.textContent = String(hours).padStart(2, '0');
        if (minutesEl) minutesEl.textContent = String(minutes).padStart(2, '0');
        if (secondsEl) secondsEl.textContent = String(seconds).padStart(2, '0');
      }
    }

    customElements.define('countdown-banner-{{ ai_gen_id }}', CountdownBanner{{ ai_gen_id }});
  })();
</script>

